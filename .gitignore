# --- Pixi environment (a directory rule would block the config.toml exception) ---
/.pixi/*
!/.pixi/config.toml

# --- Python bytecode and package builds ---
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/

# --- Development caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Data: never committed ---
/data/*
!/data/.gitkeep

# --- Generated ML outputs ---
/outputs/
/checkpoints/

# --- Logs and temporary files ---
/logs/
/tmp/
*.log

# --- Local secrets and configuration ---
.env
.env.*
!.env.example
*.local.toml
*.local.yaml
*.local.yml
